# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.

# --- Site branding ---
COMPANY_NAME="caseclosed"
SITE_NAME="caseclosed"

# --- Shopify storefront (required) ---
# Your store subdomain, e.g. caseclosed.myshopify.com
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
# Storefront API access token (read-only, public storefront data)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Secret used to validate Shopify revalidation webhooks
SHOPIFY_REVALIDATION_SECRET=""

# --- Shopify Admin (required for refund-request writes) ---
# Admin API access token — writes the $app:refund_request metaobject
SHOPIFY_ADMIN_ACCESS_TOKEN=""

# --- Refund request form ---
# Endpoint the refund-request form posts to
REFUND_FORM_ENDPOINT=""

# --- Demo / mock data ---
# Set to "true" to render sample products instead of live Shopify data.
# Leave unset/false to use real Shopify data only.
USE_DEMO_PRODUCTS="false"

# --- Vercel (auto-provided in deployments; no need to set locally) ---
# VERCEL_PROJECT_PRODUCTION_URL is injected by Vercel at build/runtime.
