# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.

# --- Site branding ---
COMPANY_NAME="caseclosed"
SITE_NAME="caseclosed"

# --- Shopify storefront (required) ---
# Your store subdomain, e.g. caseclosed.myshopify.com
SHOPIFY_STORE_DOMAIN="[your-shopify-store-subdomain].myshopify.com"
# Storefront API access token (read-only, public storefront data)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Secret used to validate Shopify revalidation webhooks
SHOPIFY_REVALIDATION_SECRET=""

# --- Shopify Admin (required for refund-request writes) ---
# Admin API access token — writes the $app:refund_request metaobject
SHOPIFY_ADMIN_ACCESS_TOKEN=""
# Used to verify product webhooks (auto size-* tagging). Defaults to the app's
# client secret (SHOPIFY_ADMIN_CLIENT_SECRET) if left unset.
SHOPIFY_WEBHOOK_SECRET=""
# Custom-app client secret — used as the product-webhook HMAC key when
# SHOPIFY_WEBHOOK_SECRET is unset. Set at least one of the two in production.
SHOPIFY_ADMIN_CLIENT_SECRET=""
# Sales-channel the storefront reads; new products are auto-published here by the
# products webhook. Defaults to the "Caseclosed Headless" publication.
SHOPIFY_HEADLESS_PUBLICATION_ID=""

# --- Refund request form ---
# Endpoint the refund-request form posts to
REFUND_FORM_ENDPOINT=""

# --- Account-synced wishlist (Customer Account API; optional) ---
# Until these are set, the wishlist stays local (localStorage) and the account
# button links to the hosted Shopify account page. See
# docs/account-wishlist-setup.md for where to copy each value from.
# Public origin of THIS app (must be a registered Callback URL host).
# NEXT_PUBLIC_APP_ORIGIN is the client-side fallback; set it to the same value.
APP_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_ORIGIN="http://localhost:3000"
# Optional: hosted Shopify account URL the account button links to until the
# Customer Account API is wired. Defaults to the store's hosted account page.
SHOPIFY_ACCOUNT_URL=""
# Credentials section of the Customer Account API settings:
SHOPIFY_CUSTOMER_CLIENT_ID=""
# Only for a confidential/web client (leave blank for a public PKCE client):
SHOPIFY_CUSTOMER_CLIENT_SECRET=""
# "Application endpoints" section (copy the exact URLs):
SHOPIFY_CUSTOMER_AUTHORIZE_ENDPOINT=""
SHOPIFY_CUSTOMER_TOKEN_ENDPOINT=""
SHOPIFY_CUSTOMER_LOGOUT_ENDPOINT=""
# Optional override; defaults to "openid email customer-account-api:full"
SHOPIFY_CUSTOMER_SCOPE=""

# --- Demo / mock data ---
# Set to "true" to render sample products instead of live Shopify data.
# Leave unset/false to use real Shopify data only.
USE_DEMO_PRODUCTS="false"

# --- Vercel (auto-provided in deployments; no need to set locally) ---
# VERCEL_PROJECT_PRODUCTION_URL is injected by Vercel at build/runtime.
